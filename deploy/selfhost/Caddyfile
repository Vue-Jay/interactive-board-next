{$LEKTRUS_DOMAIN} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
  @interface_preview {
    path /board/00000000-0000-4000-8000-00000000a11a
    query layout-editor=1 layout-preview=1
  }
  @not_interface_preview not {
    path /board/00000000-0000-4000-8000-00000000a11a
    query layout-editor=1 layout-preview=1
  }
  header @not_interface_preview X-Frame-Options DENY
  header @interface_preview {
    X-Frame-Options SAMEORIGIN
    Content-Security-Policy "frame-ancestors 'self'"
  }
  @api path /api/v1/*
  handle @api {
    reverse_proxy api:8000
  }
  handle /assets/* {
    root * /srv/web
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
  handle {
    root * /srv/web
    try_files {path} /index.html
    header Cache-Control "no-cache"
    file_server
  }
}
