# EXAMPLE ONLY. Never commit your real credentials.
# Use a unique HTTPS domain and the same origin, e.g. https://lektrus.example.
LEKTRUS_DOMAIN=lektrus.example
LEKTRUS_SITE_ORIGIN=https://lektrus.example
# URL-encode reserved URI characters in this password; prefer [A-Za-z0-9_-].
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_LONG_RANDOM_PASSWORD
# Generate independently, at least 32 random bytes. Do not reuse Supabase JWT secrets.
LEKTRUS_JWT_SECRET=REPLACE_WITH_INDEPENDENT_LONG_RANDOM_SECRET
