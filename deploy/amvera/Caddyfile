{
  admin off
  auto_https off
}

:8080 {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
  @same_origin_frame `(path('/board/00000000-0000-4000-8000-00000000a11a') && query({'layout-editor':'1','layout-preview':'1'})) || (path('/board/*','/demo/board','/demo/board/') && query({'lektrus-board-frame':'1'}))`
  @not_same_origin_frame `!((path('/board/00000000-0000-4000-8000-00000000a11a') && query({'layout-editor':'1','layout-preview':'1'})) || (path('/board/*','/demo/board','/demo/board/') && query({'lektrus-board-frame':'1'})))`
  header @not_same_origin_frame X-Frame-Options DENY
  header @same_origin_frame {
    X-Frame-Options SAMEORIGIN
    Content-Security-Policy "frame-ancestors 'self'"
  }

  # Amvera terminates TLS before forwarding to this HTTP listener. Redirect
  # public browser pages, retaining old API and static asset URLs for clients
  # that are already connected (including WebSocket and service workers).
  @legacy_page {
    host www.lektrus.ru lectrus.ru www.lectrus.ru lektrus-vuejay.msk1.amvera.tech
    method GET HEAD
    not path /api/v1 /api/v1/* /assets/* /fonts/* /models/* /site/* /sw.js /manifest.webmanifest /icons.svg /lektrus-*.png /version.json /deployment-check.json
  }
  handle @legacy_page {
    redir https://lektrus.ru{uri} 308
  }

  @api path /api/v1 /api/v1/*
  handle @api {
    reverse_proxy 127.0.0.1:8000
  }

  handle /assets/* {
    @current_asset file {
      root /srv/web
    }
    handle @current_asset {
      root * /srv/web
      header Cache-Control "public, max-age=31536000, immutable"
      file_server
    }
    @old_asset file {
      root /data/web-releases
    }
    handle @old_asset {
      root * /data/web-releases
      header Cache-Control "public, max-age=31536000, immutable"
      file_server
    }
    handle {
      header Cache-Control "no-store"
      respond 404
    }
  }

  handle {
    root * /srv/web
    try_files {path} /index.html
    header Cache-Control "no-cache"
    file_server
  }
}
