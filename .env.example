# Copy to .env only after creating and verifying a SEPARATE Lectris Supabase project.
# Do not commit .env files or paste API/database secrets into chat.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# For a self-hosted Lektrus build, set these two values.
# During the migration, leave Supabase values above only for features not yet ported.
# Remove Supabase configuration only after full feature and data parity is verified.
# VITE_LEKTRUS_BACKEND=selfhost
# VITE_LEKTRUS_API_ORIGIN=https://your-lektrus-domain.example

# Enable only in the dedicated Lectris project after applying organization SQL.
VITE_LECTRIS_ORG_SYNC=false
VITE_LECTRIS_ISOLATED_SUPABASE_REF=

# Optional public Telegram channel/chat link shown beside feedback forms.
VITE_TELEGRAM_URL=
